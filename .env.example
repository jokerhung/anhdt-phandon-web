# Không dùng các giá trị mẫu này trong production.
ADMIN_USERNAME=admin
# Tạo bằng: npm run hash-password
ADMIN_PASSWORD_HASH=scrypt:v1:REPLACE_WITH_43_CHAR_BASE64URL_SALT:REPLACE_WITH_86_CHAR_BASE64URL_HASH
SESSION_TTL_SECONDS=28800
# Port cho npm run dev / npm start. Khi đổi port local, cập nhật APP_ORIGIN tương ứng.
PORT=3000
APP_ORIGIN=http://localhost:3000
# Các origin bổ sung được phép đăng nhập/đăng xuất, phân cách bằng dấu phẩy.
# APP_ORIGIN luôn được phép. Để trống nếu không cần; không dùng wildcard (*).
ALLOWED_ORIGINS=http://127.0.0.1:3000
GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
GOOGLE_DRIVE_FOLDER_ID=
SHEETS_CACHE_TTL_SECONDS=60
APP_TIME_ZONE=Asia/Ho_Chi_Minh
# Production sau reverse proxy HTTPS: đặt true chỉ khi proxy ghi đè X-Forwarded-For.
TRUST_PROXY=false
# Mã release/commit để client reload khi chuyển phiên bản.
DEPLOYMENT_VERSION=local-dev
