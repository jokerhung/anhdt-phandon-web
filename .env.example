# Không dùng các giá trị mẫu này trong production.
ADMIN_USERNAME=admin
# Tạo bằng: npm run hash-password
ADMIN_PASSWORD_HASH=scrypt:v1:REPLACE_WITH_43_CHAR_BASE64URL_SALT:REPLACE_WITH_86_CHAR_BASE64URL_HASH
SESSION_TTL_SECONDS=28800
APP_ORIGIN=http://localhost:3000
GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
GOOGLE_DRIVE_FOLDER_ID=
SHEETS_CACHE_TTL_SECONDS=60
APP_TIME_ZONE=Asia/Ho_Chi_Minh
TRUST_PROXY=false

